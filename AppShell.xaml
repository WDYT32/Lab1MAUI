<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Lab1MAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Lab1MAUI.Views"
    xmlns:participants="clr-namespace:Lab1MAUI.Views.Participants"
    Title="Генератор розкладу"
    FlyoutBehavior="Flyout">

    
    
    <FlyoutItem Title="Головна (Дашборд)">
        <ShellContent Route="DashboardPage" ContentTemplate="{DataTemplate views:DashboardPage}" />
    </FlyoutItem>
    
    <FlyoutItem Title="Дисципліни">
        <ShellContent Route="DisciplinesPage" ContentTemplate="{DataTemplate participants:DisciplinesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Аудиторії">
        <ShellContent Route="RoomsPage" ContentTemplate="{DataTemplate participants:RoomsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Викладачі">
        <ShellContent Route="TeachersPage" ContentTemplate="{DataTemplate participants:TeachersPage}" />
    </FlyoutItem>
    
    <FlyoutItem Title="Студентські групи">
        <ShellContent Route="StudentGroupsPage" ContentTemplate="{DataTemplate participants:StudentGroupsPage}" />
    </FlyoutItem>
    
    <FlyoutItem Title="Налаштування">
        <ShellContent Route="SettingsPage" ContentTemplate="{DataTemplate views:SettingsPage}" />
    </FlyoutItem>

</Shell>
