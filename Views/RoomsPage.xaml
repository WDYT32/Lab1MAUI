<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Lab1MAUI.ViewModels"
             x:Class="Lab1MAUI.Views.RoomsPage"
             Title="Аудиторії">

    <Grid RowDefinitions="Auto, *">
        
        <Frame Grid.Row="0" Margin="10" Padding="15" BackgroundColor="#2B0B98" CornerRadius="10">
            <Grid ColumnDefinitions="*, Auto">
                <Label Text="Додати нову аудиторію" TextColor="White" FontSize="16" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="+" 
                        Command="{Binding AddRoomCommand}" 
                        BackgroundColor="White" TextColor="#2B0B98" 
                        WidthRequest="40" HeightRequest="40" CornerRadius="20" 
                        FontAttributes="Bold" FontSize="20" Padding="0" />
            </Grid>
        </Frame>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Rooms}" Margin="10,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Редагувати" BackgroundColor="LightBlue" 
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:RoomsViewModel}}, Path=EditRoomCommand}" 
                                           CommandParameter="{Binding .}" />
                                <SwipeItem Text="Видалити" BackgroundColor="Red" 
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:RoomsViewModel}}, Path=DeleteRoomCommand}" 
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Frame Margin="0,5" Padding="15" CornerRadius="10" BackgroundColor="White" HasShadow="True">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:RoomsViewModel}}, Path=EditRoomCommand}" CommandParameter="{Binding .}" />
                                <DragGestureRecognizer CanDrag="True" 
                                                       DragStartingCommand="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:RoomsViewModel}}, Path=DragStartingCommand}" 
                                                       DragStartingCommandParameter="{Binding .}" />
                                <DropGestureRecognizer AllowDrop="True" 
                                                       DropCommand="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:RoomsViewModel}}, Path=DropCommand}" 
                                                       DropCommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="{Binding Name}" FontSize="16" VerticalOptions="Center" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding Capacity, StringFormat='Місткість: {0}'}" FontSize="14" TextColor="Gray" VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
