<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Lab1MAUI.ViewModels"
             x:Class="Lab1MAUI.Views.RoomEditPage"
             Title="Профіль аудиторії">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <Label Text="Основні дані" FontSize="18" FontAttributes="Bold" />
            
            <VerticalStackLayout Spacing="5">
                <Label Text="Назва аудиторії (номер)" FontSize="14" TextColor="Gray" />
                <Entry Text="{Binding Name, Mode=TwoWay}" Placeholder="Напр. 101a" BackgroundColor="White" />
            </VerticalStackLayout>
            
            <VerticalStackLayout Spacing="5">
                <Label Text="Місткість (кількість студентів)" FontSize="14" TextColor="Gray" />
                <Entry Text="{Binding Capacity, Mode=TwoWay}" Keyboard="Numeric" BackgroundColor="White" />
            </VerticalStackLayout>
            
            <Button Text="Зберегти" 
                    Command="{Binding SaveCommand}" 
                    BackgroundColor="#4CAF50" 
                    TextColor="White" 
                    Margin="0,20,0,0"
                    HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
