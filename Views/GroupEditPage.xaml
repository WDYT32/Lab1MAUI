<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Lab1MAUI.ViewModels"
             x:Class="Lab1MAUI.Views.GroupEditPage"
             Title="Профіль групи">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <Label Text="Основні дані" FontSize="18" FontAttributes="Bold" />
            
            <Entry Text="{Binding GroupName, Mode=TwoWay}" Placeholder="Назва групи (напр. ПЗПІ-21)" />
            
            <BoxView HeightRequest="1" Color="LightGray" />
            
            <Grid ColumnDefinitions="*, Auto">
                <Label Text="Вимоги до дисциплін:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="+" Command="{Binding AddRequirementCommand}" WidthRequest="40" HeightRequest="40" />
            </Grid>

            <CollectionView ItemsSource="{Binding Requirements}" HeightRequest="200">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Видалити" BackgroundColor="Red" 
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:GroupEditViewModel}}, Path=DeleteRequirementCommand}" 
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Frame Margin="0,5" Padding="10" CornerRadius="8" BackgroundColor="White">
                                <Grid ColumnDefinitions="*, Auto, Auto">
                                    <Label Grid.Column="0" Text="{Binding DisciplineName}" FontSize="14" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="Годин:" FontSize="14" VerticalOptions="Center" Margin="5,0" />
                                    <Entry Grid.Column="2" Text="{Binding RequiredHours, Mode=TwoWay}" Keyboard="Numeric" WidthRequest="60" />
                                </Grid>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Модальне вікно / Панель вибору дисципліни -->
            <Frame BorderColor="#2B0B98" BackgroundColor="#E5E7EB" Padding="15" CornerRadius="10" IsVisible="{Binding DisciplineSelection.IsVisible}" Margin="0,10">
                <VerticalStackLayout Spacing="10" BindingContext="{Binding DisciplineSelection}">
                    <Label Text="Пошук дисципліни" FontAttributes="Bold" FontSize="16" />
                    <Entry Text="{Binding SearchQuery, Mode=TwoWay}" Placeholder="Введіть назву..." BackgroundColor="White" />
                    
                    <CollectionView ItemsSource="{Binding FilteredDisciplines}" HeightRequest="120">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Margin="0,3" Padding="10" CornerRadius="5" BackgroundColor="White">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DisciplineSelectionViewModel}}, Path=SelectCommand}" CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>
                                    <Label Text="{Binding Name}" FontSize="14" />
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    
                    <Button Text="Скасувати" Command="{Binding CancelCommand}" BackgroundColor="Gray" TextColor="White" />
                </VerticalStackLayout>
            </Frame>

            <BoxView HeightRequest="1" Color="LightGray" />

            <Label Text="Особисті Обмеження" FontSize="18" FontAttributes="Bold" />
            
            <!-- Constraint Form з BindingContext = ConstraintForm -->
            <Frame BindingContext="{Binding ConstraintForm}" BackgroundColor="#F5F5F5" Padding="15" CornerRadius="8" HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <Picker Title="Виберіть тип обмеження" ItemsSource="{Binding ConstraintTypes}" SelectedItem="{Binding SelectedConstraintType}" />
                    
                    <!-- Підформа для DailyLimit -->
                    <VerticalStackLayout IsVisible="{Binding IsDailyLimitSelected}" Spacing="5">
                        <Label Text="💡 Цє обмеження не дозволить розкладу поставити більше уроків, ніж вказано, в межах одного дня." FontSize="12" TextColor="Gray" FontAttributes="Italic" />
                        <Label Text="Максимум уроків на день:" FontSize="14" />
                        <Entry Text="{Binding DailyLimitValue, Mode=TwoWay}" Keyboard="Numeric" BackgroundColor="White" />
                    </VerticalStackLayout>
                    
                    <!-- Підформа для MaxConsecutive -->
                    <VerticalStackLayout IsVisible="{Binding IsMaxConsecutiveSelected}" Spacing="5">
                        <Label Text="💡 Цє обмеження змусить розклад розбивати підряд йдучі уроки вікном або уроком іншого предмета." FontSize="12" TextColor="Gray" FontAttributes="Italic" />
                        <Label Text="Максимум уроків підряд:" FontSize="14" />
                        <Entry Text="{Binding MaxConsecutiveValue, Mode=TwoWay}" Keyboard="Numeric" BackgroundColor="White" />
                    </VerticalStackLayout>

                    <!-- Підформа для Assignment -->
                    <VerticalStackLayout IsVisible="{Binding IsAssignmentSelected}" Spacing="5">
                        <Label Text="💡 Примусово призначає обраного викладача для цієї групи." FontSize="12" TextColor="Gray" FontAttributes="Italic" />
                        <Label Text="Оберіть викладача (або залиште пустим для будь-якого):" FontSize="14" />
                        <Picker Title="Оберіть викладача" 
                                ItemsSource="{Binding AvailableTeachers}" 
                                ItemDisplayBinding="{Binding LastName}"
                                SelectedItem="{Binding SelectedAssignmentTeacher}" 
                                BackgroundColor="White" />
                    </VerticalStackLayout>
                    
                    <Button Text="Додати обмеження в список" Command="{Binding AddConstraintCommand}" BackgroundColor="#2B0B98" TextColor="White" Margin="0,10,0,0" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="💡 Підказка: Затисніть та перетягніть обмеження (Drag &amp; Drop) для зміни його важливості. Ті, що вище, виконуються першими." FontSize="12" TextColor="#4198B4" FontAttributes="Italic" />

            <CollectionView ItemsSource="{Binding Constraints}" HeightRequest="200">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Видалити" BackgroundColor="Red" 
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:GroupEditViewModel}}, Path=DeleteConstraintCommand}" 
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            
                            <Frame Margin="0,5" Padding="10" CornerRadius="8" BackgroundColor="White">
                                <Frame.GestureRecognizers>
                                    <DragGestureRecognizer CanDrag="True" 
                                                           DragStartingCommand="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:GroupEditViewModel}}, Path=DragStartingConstraintCommand}" 
                                                           DragStartingCommandParameter="{Binding .}" />
                                    <DropGestureRecognizer AllowDrop="True" 
                                                           DropCommand="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:GroupEditViewModel}}, Path=DropConstraintCommand}" 
                                                           DropCommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <Grid>
                                    <Label Text="{Binding .}" FontSize="14" VerticalOptions="Center" />
                                </Grid>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Зберегти" 
                    Command="{Binding SaveCommand}" 
                    BackgroundColor="#4CAF50" 
                    TextColor="White" 
                    Margin="0,20,0,0"
                    HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
