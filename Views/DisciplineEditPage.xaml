<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Lab1MAUI.ViewModels"
             x:Class="Lab1MAUI.Views.DisciplineEditPage"
             Title="Редагування дисципліни">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Назва дисципліни" FontSize="16" FontAttributes="Bold" />
            <Entry Text="{Binding Name, Mode=TwoWay}" Placeholder="Назва (напр. Математика [Лк])" />
            
            <BoxView HeightRequest="1" Color="LightGray" Margin="0,10" />

            <Label Text="Обмеження дисципліни" FontSize="18" FontAttributes="Bold" />
            
            <Frame BorderColor="LightGray" CornerRadius="8" Padding="15" BackgroundColor="#F9F9F9" BindingContext="{Binding ConstraintForm}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Додати нове обмеження:" FontSize="14" />
                    
                    <Picker ItemsSource="{Binding ConstraintTypes}" 
                            SelectedItem="{Binding SelectedConstraintType}" 
                            Title="Оберіть тип обмеження..." />
                            
                    <VerticalStackLayout IsVisible="{Binding IsDailyLimitSelected}" Spacing="10">
                        <Label Text="💡 Цє обмеження не дозволить розкладу поставити більше уроків цієї дисципліни, ніж вказано, в межах одного дня для однієї групи." FontSize="12" TextColor="Gray" FontAttributes="Italic" />
                        <Label Text="Глобальний ліміт уроків на день (на групу):" />
                        <Entry Text="{Binding DailyLimitValue, Mode=TwoWay}" Keyboard="Numeric" />
                    </VerticalStackLayout>
                    
                    <Button Text="Додати обмеження" Command="{Binding AddConstraintCommand}" />
                </VerticalStackLayout>
            </Frame>
            
            <Label Text="💡 Підказка: Затисніть та перетягніть обмеження (Drag &amp; Drop) для зміни його важливості. Ті, що вище, виконуються першими." FontSize="12" TextColor="#4198B4" FontAttributes="Italic" Margin="0,10,0,0" />

            <CollectionView ItemsSource="{Binding Constraints}" Margin="0,10,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Видалити" BackgroundColor="Red" 
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DisciplineEditViewModel}}, Path=DeleteConstraintCommand}" 
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            
                            <Frame Margin="0,5" Padding="10" CornerRadius="8" BackgroundColor="White">
                                <Frame.GestureRecognizers>
                                    <DragGestureRecognizer CanDrag="True" 
                                                           DragStartingCommand="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DisciplineEditViewModel}}, Path=DragStartingConstraintCommand}" 
                                                           DragStartingCommandParameter="{Binding .}" />
                                    <DropGestureRecognizer AllowDrop="True" 
                                                           DropCommand="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DisciplineEditViewModel}}, Path=DropConstraintCommand}" 
                                                           DropCommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <Grid>
                                    <Label Text="{Binding .}" FontSize="14" VerticalOptions="Center" />
                                </Grid>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Зберегти" Command="{Binding SaveCommand}" BackgroundColor="#2B0B98" TextColor="White" Margin="0,20,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
