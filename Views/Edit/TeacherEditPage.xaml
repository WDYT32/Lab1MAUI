<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Lab1MAUI.ViewModels.Edit"
             xmlns:views="clr-namespace:Lab1MAUI.Views.Edit"
             x:Class="Lab1MAUI.Views.Edit.TeacherEditPage"
             Title="Профіль викладача">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <Label Text="Основні дані" FontSize="18" FontAttributes="Bold" />
            
            <Entry Text="{Binding LastName, Mode=TwoWay}" Placeholder="Прізвище" Keyboard="Text" />
            <Entry Text="{Binding FirstName, Mode=TwoWay}" Placeholder="Ім'я" Keyboard="Text" />
            <Entry Text="{Binding Patronymic, Mode=TwoWay}" Placeholder="По батькові" Keyboard="Text" />
            
            <Label Text="Цільова кількість уроків на тиждень:" FontSize="16" />
            <Entry Text="{Binding TargetLessons, Mode=TwoWay}" Keyboard="Numeric" />

            <BoxView HeightRequest="1" Color="LightGray" />
            
            <Grid ColumnDefinitions="*, Auto">
                <Label Text="Компетенції:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="+" Command="{Binding AddCompetenceCommand}" WidthRequest="40" HeightRequest="40" />
            </Grid>

            <views:DisciplineSelectionView IsVisible="{Binding DisciplineSelection.IsVisible}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Competences}" Spacing="5">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Видалити" BackgroundColor="Red" 
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TeacherEditViewModel}}, Path=DeleteCompetenceCommand}" 
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border Padding="10" StrokeShape="RoundRectangle 8" BackgroundColor="White" StrokeThickness="0">
                                <Label Text="{Binding DisciplineName}" FontSize="14" />
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="LightGray" />

            <views:ConstraintsEditorView />

            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,20,0,0">
                <Button Grid.Column="0" 
                        Text="Скасувати" 
                        Command="{Binding GoBackCommand}" 
                        BackgroundColor="#757575" 
                        TextColor="White" 
                        HeightRequest="50" />
                <Button Grid.Column="1" 
                        Text="Зберегти" 
                        Command="{Binding SaveCommand}" 
                        BackgroundColor="#4CAF50" 
                        TextColor="White" 
                        HeightRequest="50" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
