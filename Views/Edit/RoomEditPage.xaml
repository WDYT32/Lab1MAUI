<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Lab1MAUI.ViewModels.Edit"
             x:Class="Lab1MAUI.Views.Edit.RoomEditPage"
             Title="Профіль аудиторії">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <Label Text="Основні дані" FontSize="18" FontAttributes="Bold" />
            
            <Entry Text="{Binding Name, Mode=TwoWay}" Placeholder="Назва аудиторії (напр. 101a)" Keyboard="Text" />
            <Entry Text="{Binding Capacity, Mode=TwoWay}" Placeholder="Місткість (кількість студентів)" Keyboard="Numeric" />
            
            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,20,0,0">
                <Button Grid.Column="0" 
                        Text="Скасувати" 
                        Command="{Binding GoBackCommand}" 
                        BackgroundColor="#757575" 
                        TextColor="White" 
                        HeightRequest="50" />
                <Button Grid.Column="1" 
                        Text="Зберегти" 
                        Command="{Binding SaveCommand}" 
                        BackgroundColor="#4CAF50" 
                        TextColor="White" 
                        HeightRequest="50" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
