<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Lab1MAUI.ViewModels.Edit"
             xmlns:views="clr-namespace:Lab1MAUI.Views.Edit"
             x:Class="Lab1MAUI.Views.Edit.DisciplineEditPage"
             Title="Редагування дисципліни">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Назва дисципліни" FontSize="16" FontAttributes="Bold" />
            <Entry Text="{Binding Name, Mode=TwoWay}" Placeholder="Назва (напр. Математика [Лк])" />
            
            <BoxView HeightRequest="1" Color="LightGray" Margin="0,10" />

            <views:ConstraintsEditorView />

            <Button Text="Зберегти" 
                    Command="{Binding SaveCommand}" 
                    BackgroundColor="#4CAF50" 
                    TextColor="White" 
                    Margin="0,20,0,0"
                    HeightRequest="50" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
