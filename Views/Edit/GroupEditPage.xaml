<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Lab1MAUI.ViewModels.Edit"
             xmlns:views="clr-namespace:Lab1MAUI.Views.Edit"
             x:Class="Lab1MAUI.Views.Edit.GroupEditPage"
             Title="Профіль групи">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <Label Text="Основні дані" FontSize="18" FontAttributes="Bold" />
            
            <Entry Text="{Binding Name, Mode=TwoWay}" Placeholder="Назва групи (напр. ПЗПІ-21)" />
            
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Label Text="Кількість студентів:" VerticalOptions="Center" />
                <Entry Text="{Binding StudentsCount, Mode=TwoWay}" Keyboard="Numeric" WidthRequest="100" />
            </HorizontalStackLayout>
            
            <BoxView HeightRequest="1" Color="LightGray" />
            
            <Grid ColumnDefinitions="*, Auto">
                <Label Text="Вимоги до дисциплін:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="+" Command="{Binding AddRequirementCommand}" WidthRequest="40" HeightRequest="40" />
            </Grid>

            <views:DisciplineSelectionView IsVisible="{Binding DisciplineSelection.IsVisible}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Requirements}" Spacing="5">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Видалити" BackgroundColor="Red" 
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:GroupEditViewModel}}, Path=DeleteRequirementCommand}" 
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border Padding="10" StrokeShape="RoundRectangle 8" BackgroundColor="White" StrokeThickness="0">
                                <Grid ColumnDefinitions="*, Auto, Auto">
                                    <Label Grid.Column="0" Text="{Binding DisciplineName}" FontSize="14" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="Уроків:" FontSize="14" VerticalOptions="Center" Margin="5,0" />
                                    <Entry Grid.Column="2" Text="{Binding RequiredLessons, Mode=TwoWay}" Keyboard="Numeric" WidthRequest="60" />
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="LightGray" />

            <views:ConstraintsEditorView />

            <Button Text="Зберегти" 
                    Command="{Binding SaveCommand}" 
                    BackgroundColor="#4CAF50" 
                    TextColor="White" 
                    Margin="0,20,0,0"
                    HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
