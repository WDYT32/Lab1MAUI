<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Lab1MAUI.ViewModels.Participants"
             x:Class="Lab1MAUI.Views.Participants.DisciplinesPage"
             Title="Дисципліни">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Button Text="+ Додати нову дисципліну" 
                Command="{Binding AddCommand}" 
                BackgroundColor="#2B0B98" 
                TextColor="White"
                HeightRequest="50"
                CornerRadius="8" />
        
        <BoxView HeightRequest="1" Color="LightGray" Margin="0,10" />
        
        <Label Text="Список дисциплін" FontSize="18" FontAttributes="Bold" />
        <Label Text="💡 Підказка: Затисніть та перетягніть дисципліну (Drag &amp; Drop), щоб змінити її глобальний пріоритет. Вища позиція у списку дає більшу вагу всім її обмеженням." FontSize="12" TextColor="#4198B4" FontAttributes="Italic" />

        <CollectionView ItemsSource="{Binding Items}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Редагувати" BackgroundColor="Orange" 
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DisciplinesViewModel}}, Path=EditCommand}" 
                                           CommandParameter="{Binding .}" />
                                <SwipeItem Text="Видалити" BackgroundColor="Red" 
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DisciplinesViewModel}}, Path=DeleteCommand}" 
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        
                        <Border Margin="0,5" Padding="15" StrokeShape="RoundRectangle 8" BackgroundColor="White" StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <DragGestureRecognizer CanDrag="True" 
                                                       DragStartingCommand="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DisciplinesViewModel}}, Path=DragStartingCommand}" 
                                                       DragStartingCommandParameter="{Binding .}" />
                                <DropGestureRecognizer AllowDrop="True" 
                                                       DropCommand="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DisciplinesViewModel}}, Path=DropCommand}" 
                                                       DropCommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="У вас ще немає доданих дисциплін. Натисніть кнопку вище, щоб додати." TextColor="Gray" HorizontalOptions="Center" Margin="0,20,0,0" HorizontalTextAlignment="Center" />
            </CollectionView.EmptyView>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
