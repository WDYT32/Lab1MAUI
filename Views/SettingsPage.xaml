<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Lab1MAUI.ViewModels"
             x:Class="Lab1MAUI.Views.SettingsPage"
             Title="Налаштування">

    <VerticalStackLayout Padding="20" Spacing="20">
        <Label Text="Конфігурація розкладу" FontSize="20" FontAttributes="Bold" />
        
        <Label Text="Кількість робочих днів:" FontSize="16" />
        <Entry Text="{Binding Days, Mode=TwoWay}" Keyboard="Numeric" />

        <Label Text="Кількість уроків на день (клітинок):" FontSize="16" />
        <Entry Text="{Binding CellsPerDay, Mode=TwoWay}" Keyboard="Numeric" />
        
        <BoxView HeightRequest="1" Color="LightGray" />
        
        <HorizontalStackLayout Spacing="10">
            <Label Text="Всього клітинок:" FontSize="16" FontAttributes="Bold" />
            <Label Text="{Binding TotalCells}" FontSize="16" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>
